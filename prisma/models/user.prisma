model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  phone      String?

  bio        String?
  city       String?
  avatar     String?
  whatsapp   String?
  instagram  String?
  facebook   String?
  linkedin   String?

  properties Property[]
  favorites  Favorite[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}